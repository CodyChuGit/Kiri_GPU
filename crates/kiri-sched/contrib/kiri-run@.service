# One Kiri stack, started and stopped by kiri-sched:
#   /box/config/kiri/stacks/<name>/compose.yaml
# Unlike kiri-stack@ (which converges a stack at boot and leaves it running
# when stopped), stopping this unit really stops the stack, which is what a
# GPU switch needs. Never enable it: the scheduler decides what runs.
#
# In GPU stacks set `restart: "no"` on every service: restarts are the
# scheduler's job, and Kiri refuses a GPU start the scheduler did not grant.
#
# `compose up` stays attached, so the unit lives exactly as long as the
# stack: when a container exits (a crash, or an engine that dies while
# loading) the unit goes inactive at once and the scheduler sees it, instead
# of waiting out start_timeout_secs. The containers' output lands in this
# unit's journal.
#
# The scheduler writes /run/kiri-sched/cards/<stack>.env before each start,
# `KIRI_SCHED_GPUS=1` (or `0,1`): the cards this stack got. A stack that
# needs one card names it, and Kiri refuses any other:
#   devices: [{driver: nvidia, device_ids: ["${KIRI_SCHED_GPUS:?}"], capabilities: [gpu]}]
# A stack that needs every card may keep `count: all`.
[Unit]
Description=Kiri stack %i (run by kiri-sched)
Requires=kiri.service
After=kiri.service box-cdi-refresh.service
RequiresMountsFor=/box /models
ConditionPathExists=/box/config/kiri/stacks/%i/compose.yaml

[Service]
Type=exec
WorkingDirectory=/box/config/kiri/stacks/%i
Environment=DOCKER_HOST=unix:///run/kiri/docker.sock
Environment=COMPOSE_PROJECT_NAME=%i
EnvironmentFile=-/run/kiri-sched/cards/%i.env
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -S /run/kiri/docker.sock ] && exit 0; sleep 1; done; exit 1'
ExecStart=/opt/box/bin/kiri-compose up --remove-orphans --abort-on-container-exit --no-color
# No --timeout: each service's stop_grace_period applies (Compose default
# 10 s), and TimeoutStopSec bounds the whole stop.
ExecStop=/opt/box/bin/kiri-compose down
# Also after the stack ended on its own: nothing exited is left behind.
ExecStopPost=/opt/box/bin/kiri-compose down
Restart=no
TimeoutStartSec=180
TimeoutStopSec=90
