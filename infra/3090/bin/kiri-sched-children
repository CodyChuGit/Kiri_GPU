#!/bin/sh
# Removes the containers a GPU runtime started itself (Wolf's game sessions),
# labelled dev.kiri.sched.parent=<stack>. kiri-run@<stack> runs this after
# every stop: Compose does not know them, and they hold the runtime's cards
# until they are gone. Usage: kiri-sched-children <stack>
#
# Helpers the runtime starts without that label (Wolf's WolfPulseAudio) can
# be listed by exact container name, one per line, in
# /box/config/kiri/stacks/<stack>/children.names.
set -eu
export DOCKER_HOST=${DOCKER_HOST:-unix:///run/kiri/docker.sock}
stack=${1:?usage: kiri-sched-children <stack>}
case $stack in */* | .* | '') echo "kiri-sched-children: bad stack name" >&2; exit 2 ;; esac
ids=$(docker ps -aq --filter "label=dev.kiri.sched.parent=$stack")
names=${KIRI_STACKS:-/box/config/kiri/stacks}/$stack/children.names
if [ -r "$names" ]; then
  while IFS= read -r n || [ -n "$n" ]; do
    case $n in '' | '#'*) continue ;; esac
    # Exact name only (the filter is a regex otherwise).
    ids="$ids $(docker ps -aq --filter "name=^/?$n\$")"
  done < "$names"
fi
# shellcheck disable=SC2086 # split on purpose
ids=$(echo $ids | tr ' ' '\n' | sort -u)
[ -n "$ids" ] || exit 0
echo "kiri-sched-children: removing $(echo "$ids" | wc -l) container(s) of $stack"
# shellcheck disable=SC2086 # one id per word
docker rm -f $ids >/dev/null
